{
  "name": "Study Grid Prep - Study Platform",
  "short_name": "Study Grid Prep",
  "id": "Study-Grid-Prep-app",
  "description": "Distraction free study platform for JEE, NEET, CUET & BOARDS with Mock Tests,Focus Timer, YouTube study playlist, Progress tracking and Todo list.",
  "start_url": "/dashboard-home.html",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "tabbed",
    "standalone",
    "minimal-ui"
  ],
  "background_color": "#F0F2F8",
  "theme_color": "#F0F2F8",
  "lang": "en",
  "dir": "auto",
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "/screenshot1.png",
      "sizes": "1080x1920",
      "type": "image/jpeg",
      "form_factor": "narrow",
      "label": "Study Grid Prep Dashboard"
    }
  ],
  "categories": [
    "education",
    "productivity"
  ],
  "widgets": [
    {
      "name": "Target Exam Countdown",
      "short_name": "Exam",
      "description": "Days left for your target exam in Study Grid Prep",
      "tag": "target-exam",
      "ms_ac_template": "widgets/exam-card.json",
      "data": "/widget-exam.html",
      "type": "application/json",
      "screenshots": [
        {
          "src": "/screenshot1.png",
          "sizes": "1080x1920",
          "label": "Exam Widget"
        }
      ],
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192"
        }
      ],
      "auth": false,
      "update": 3600
    }
  ],
  "shortcuts": [
    {
      "name": "Focus Timer",
      "short_name": "Timer",
      "description": "Start a focus timer",
      "url": "/timer.html",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Todo List",
      "short_name": "Todo",
      "description": "View your todo list",
      "url": "/todo.html",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Playlist",
      "short_name": "Playlist",
      "description": "Open study playlist",
      "url": "/playlist.html",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Mock Tests",
      "short_name": "Tests",
      "description": "Take a mock test",
      "url": "/mock.html",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Target Exam",
      "short_name": "Exam",
      "description": "Open Profile",
      "url": "/profile.html",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "share_target": {
    "action": "/playlist.html",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "file_handlers": [
    {
      "action": "/notes-hub.html",
      "name": "Study Notes & Documents",
      "accept": {
        "text/plain": [
          ".txt"
        ],
        "application/pdf": [
          ".pdf"
        ]
      }
    }
  ],
  "launch_handler": {
    "client_mode": [
      "navigate-existing",
      "auto"
    ]
  },
  "protocol_handlers": [
    {
      "protocol": "web+sgp",
      "url": "/dashboard-home.html?action=%s"
    }
  ],
  "note_taking": {
    "new_note_url": "/todo.html?mode=note"
  },
  "edge_side_panel": {
    "preferred_width": 480
  }
}