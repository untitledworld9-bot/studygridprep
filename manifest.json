{
  "name": "Study Grid Prep - Study Platform",
  "short_name": "Study Grid Prep",
  "id": "Study-Grid-Prep-app",
  "description": "Distraction-free exam preparation for JEE, NEET, CUET & Boards with live Exam Alerts, Study Reminders, Mock Tests, Focus Timer, Study Playlists and Focus Runner Game.",
  "start_url": "/dashboard-home.html",
  "scope": "/",
  "display": "tabbed",
  "display_override": [
    "tabbed",
    "window-controls-overlay",
    "standalone",
    "minimal-ui"
  ],
  "background_color": "#F0F2F8",
  "theme_color": "#F0F2F8",
  "lang": "en",
  "dir": "auto",
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "/screenshot1.png",
      "sizes": "1080x1920",
      "type": "image/jpeg",
      "form_factor": "narrow",
      "label": "Study Grid Prep Mobile Study Dashboard"
    },
    {
      "src": "/screenshot-wide.png",
      "sizes": "1920x1080",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Study Grid Prep Desktop Study Workspace"
    }
  ],
  "categories": [
    "education",
    "productivity"
  ],
  "widgets": [
    {
      "name": "Target Exam Countdown",
      "short_name": "Exam",
      "description": "Days left for your target exam in Study Grid Prep",
      "tag": "target-exam",
      "ms_ac_template": "widgets/exam-card.json",
      "data": "/widget-exam.html",
      "type": "application/json",
      "screenshots": [
        {
          "src": "/screenshot1.png",
          "sizes": "1080x1920",
          "label": "Exam Widget"
        }
      ],
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192"
        }
      ],
      "auth": false,
      "update": 3600
    }
  ],
  "shortcuts": [
    {
      "name": "Focus Timer",
      "short_name": "Timer",
      "description": "Start a focus timer",
      "url": "/timer.html",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Todo List",
      "short_name": "Todo",
      "description": "View your todo list",
      "url": "/todo.html",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Playlist",
      "short_name": "Playlist",
      "description": "Open study playlist",
      "url": "/playlist.html",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Mock Tests",
      "short_name": "Tests",
      "description": "Take a mock test",
      "url": "/mock.html",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Target Exam",
      "short_name": "Exam",
      "description": "Open Profile",
      "url": "/profile.html",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "share_target": {
    "action": "/playlist.html",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "file_handlers": [
    {
      "action": "/notes-hub.html",
      "name": "Study Notes & Documents",
      "accept": {
        "text/plain": [
          ".txt"
        ],
        "application/pdf": [
          ".pdf"
        ]
      }
    }
  ],
  "launch_handler": {
    "client_mode": [
      "navigate-existing",
      "auto"
    ]
  },
  "protocol_handlers": [
    {
      "protocol": "web+sgp",
      "url": "/dashboard-home.html?action=%s"
    }
  ],
  "note_taking": {
    "new_note_url": "/todo.html?mode=note"
  },
  "edge_side_panel": {
    "preferred_width": 480
  },
  "tab_strip": {
    "home_tab": {
      "scope_patterns": [
        {
          "pathname": "/dashboard-home.html"
        },
        {
          "pathname": "/"
        },
        {
          "pathname": "/index.html"
        }
      ]
    },
    "new_tab_button": {
      "url": "/dashboard-home.html"
    }
  },
  "permissions": [
    "notifications",
    "periodic-background-sync",
    "background-sync"
  ],
  "orientation": "portrait-primary",
  "related_applications": [
    {
      "platform": "play",
      "id": "online.studygridprep.twa",
      "url": "https://play.google.com/store/apps/details?id=online.studygridprep.twa"
    },
    {
      "platform": "webapp",
      "url": "https://studygridprep.online/manifest.json"
    }
  ],
  "iarc_rating_id": "e84b072d-71b3-4d3e-86ae-31a8ce4e53b7",
  "scope_extensions": [
    {
      "origin": "https://studygridprep.online"
    },
    {
      "origin": "https://www.studygridprep.online"
    },
    {
      "origin": "https://untitled-world-2e645.firebaseapp.com"
    },
    {
      "origin": "https://untitled-world-2e645.web.app"
    },
    {
      "origin": "https://accounts.google.com"
    }
  ]
}